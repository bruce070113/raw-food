rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['orderNumber', 'customerName', 'customerPhone', 'address', 'quantity', 'totalPrice', 'status', 'createdAt'])
        && data.orderNumber is string && data.orderNumber.size() <= 64
        && data.customerName is string && data.customerName.size() <= 100
        && data.customerPhone is string && data.customerPhone.size() <= 30
        && data.address is string && data.address.size() <= 255
        && data.quantity is number && data.quantity >= 1 && data.quantity <= 100
        && data.totalPrice is number && data.totalPrice >= 0
        && data.status in ['PENDING_PAYMENT', 'PAID', 'PREPARING', 'SHIPPED', 'COMPLETED', 'CANCELLED']
        && data.createdAt is string && data.createdAt.size() <= 40;
    }

    match /orders/{orderId} {
      allow create: if isValidId(orderId) && isValidOrder(request.resource.data);
      allow get: if isValidId(orderId);
      allow list: if true;
      allow update: if isValidId(orderId)
        && isValidOrder(request.resource.data)
        && request.resource.data.orderNumber == resource.data.orderNumber;
      allow delete: if false;
    }
  }
}
